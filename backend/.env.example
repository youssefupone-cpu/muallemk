# معلّمك — متغيرات البيئة (انسخه إلى .env وعدّل ما يلزم)

# --- الخادم ---
# HOST=0.0.0.0
# PORT=8000

# --- المزوّد الافتراضي ---
# DEFAULT_PROVIDER=ollama
# DEFAULT_MODEL=gemma3:1b-it-qat
# OLLAMA_BASE_URL=http://localhost:11434

# --- RAG ---
# RAG_EMBED_MODEL=nomic-embed-text
# RAG_TOP_K=8

# --- البحث على الويب ---
# TAVILY_API_KEY=            # مفتاح Tavily (اختياري — SearXNG محلي بديل)
# SEARXNG_URL=http://localhost:8080

# --- التخزين ---
# DATA_DIR=data

# --- الأمان والحدود (P0) ---
# MAX_UPLOAD_MB=50
# MAX_FILES_PER_UPLOAD=10
# MAX_DOCUMENT_CHARS=2000000
# MAX_IMAGE_PIXELS=100000000
# RATE_LIMIT_PER_MINUTE=60      # 0 = تعطيل
# CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002   # فارغ = لا CORS
# DOCS_ENABLED=true             # false في الإنتاج لإخفاء /docs و /redoc

# --- مفاتيح المزوّدين (تُمرَّر من الواجهة أيضاً) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
