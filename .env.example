# معلّمك — مساعد الدراسة
# ملف البيئة النموذجي. انسخه إلى .env وعدّل القيم.

# ---------- الخدمات ----------
# منافذ المضيف (غيّرها إن كانت مشغولة على جهازك)
BACKEND_PORT=8000
FRONTEND_PORT=3002
OLLAMA_PORT=11434

# ---------- المزوّد الافتراضي (محلي أولاً) ----------
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

